# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# LLM usado na classificação das empresas e na análise da ideia (motor/).
# Chave: https://aistudio.google.com/apikey
LLM_PROVEDOR=gemini
GEMINI_API_KEY=
# Barato e rápido, para classificar em massa
LLM_MODELO_CLASSIFICACAO=gemini-3.5-flash-lite
# Mais forte, para a análise da ideia (ao vivo)
LLM_MODELO_ANALISE=gemini-3.8-flash

# Caminho do banco local (gerado pelo script de dados/)
GENO_DB=dados/geno.duckdb

# Identificação do projeto no User-Agent da coleta de sites
GENO_USER_AGENT=GENO-Ibmec/0.1 (projeto academico)
