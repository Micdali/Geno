# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# LLM usado na classificação das empresas e na análise da ideia (motor/).
# Provedor: gemini ou openai
# Chave Gemini: https://aistudio.google.com/apikey
# Chave OpenAI: https://platform.openai.com/api-keys
LLM_PROVEDOR=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modelos: deixe comentado para usar o padrão do provedor (motor/config.py).
#   openai: classificação gpt-6-luna; ao vivo gpt-6-luna,gpt-5.6-luna,gpt-5.4-nano
#   gemini: classificação gemini-3.5-flash-lite; ao vivo gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# LLM_MODELO_CLASSIFICACAO=
# LLM_MODELOS_AO_VIVO=
# Esforço de raciocínio na OpenAI (none é o mais rápido)
# OPENAI_ESFORCO=none

# Caminho do banco local (gerado pelo script de dados/)
GENO_DB=dados/geno.duckdb

# Identificação do projeto no User-Agent da coleta de sites
GENO_USER_AGENT=GENO-Ibmec/0.1 (projeto academico)
